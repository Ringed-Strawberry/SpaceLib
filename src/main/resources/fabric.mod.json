{
  "schemaVersion": 1,
  "id": "spacelib",
  "version": "${version}",
  "name": "SpaceLib",
  "description": "A library mod for Saturn's Rings' mods",
  "authors": [
    "Saturn's Rings"
  ],
  "contact": {},
  "license": "MIT",
  "accessWidener" : "spacelib.classtweaker",
  "icon": "assets/spacelib/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "ringed_strawberry.github.io.spacelib.client.SpacelibDataGenerator"
    ],
    "client": [
      "ringed_strawberry.github.io.spacelib.client.SpacelibClient"
    ],
    "main": [
      "ringed_strawberry.github.io.spacelib.Spacelib"
    ]
  },
  "mixins": [
    "spacelib.mixins.json",
    {
      "config": "spacelib.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=25",
    "minecraft": "${minecraft_version}"
  }
}
